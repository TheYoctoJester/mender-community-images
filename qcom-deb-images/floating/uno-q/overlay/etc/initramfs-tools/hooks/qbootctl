#!/bin/sh
# initramfs-tools hook: ship qbootctl (and its libraries) in the initrd so the
# abslot local-top script can query/switch the Qualcomm A/B boot slot.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
    prereqs) prereqs; exit 0 ;;
esac
. /usr/share/initramfs-tools/hook-functions

copy_exec /usr/bin/qbootctl /usr/bin
